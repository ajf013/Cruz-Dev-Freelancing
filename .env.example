# Cosmos DB Configuration (Azure NoSQL Storage)
COSMOS_DB_ENDPOINT=https://your-cosmos-endpoint.documents.azure.com:443/
COSMOS_DB_KEY=your_primary_secret_key
COSMOS_DB_DATABASE_ID=some_unique_value
COSMOS_DB_CONTAINER_ID=Bookings

# Fallback Passcode Authentication (Local Only)
ADMIN_PASSWORD=admin123

# Microsoft Entra ID (Azure App Registration) Configuration
AZURE_AD_TENANT_ID=your_tenant_id_guid
AZURE_AD_CLIENT_ID=your_client_id_guid
AZURE_AD_CLIENT_SECRET=your_client_secret_value
ADMIN_EMAIL=your-email@domain.com
ADMIN_PATH=/appname-secret-admin
